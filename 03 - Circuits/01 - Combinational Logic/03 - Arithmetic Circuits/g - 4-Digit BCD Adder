module top_module ( 
    input [15:0] a, b,
    input cin,
    output cout,
    output [15:0] sum );
    
    wire [4:0] carry; //Carry from each adder, the last carry is Cout
    assign carry[0] = cin; //First carry is the cin 
    assign cout = carry[4];
    
    genvar i;
    generate
        for (i = 0; i < 4; i= i +1) begin : gen_adders
            bcd_fadd inst(
                .a(a[i*4 +: 4]), //[i*4 +: 4] = [starting bit +: width], i = 0: [0*4 +:4] meaning start at 0, go four more until end = [4:0]
                .b(b[i*4 +: 4]), 
                .cin(carry[i]), 
                .cout(carry[i+1]), 
                .sum(sum[i*4 +: 4])
            );
        end
    endgenerate
                     
                

endmodule
