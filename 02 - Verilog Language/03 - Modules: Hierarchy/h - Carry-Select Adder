module top_module(
    input [31:0] a,
    input [31:0] b,
    output [31:0] sum
);
	wire cout;
    wire nada1, nada2;
    wire [15:0] sum0, sum1;
    add16 out1(a[15:0], b[15:0], 0, sum[15:0], cout);
    add16 out2(a[31:16], b[31:16], 0, sum0, nada1);
    add16 out3(a[31:16], b[31:16], 1, sum1, nada2);
    
    //Thing on left of : is if cout is TRUE/HIGH (1), on the right is if cout is FALSE/LOW (0)
    assign sum[31:16] = cout ? sum1 : sum0; //? operator: Conditional operator (1 bit true or false)
    
endmodule
