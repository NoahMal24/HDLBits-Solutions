module top_module(
    input [31:0] a,
    input [31:0] b,
    input sub,
    output [31:0] sum
);
    wire [31:0] newb;
    wire carry, nada;
    wire [31:0] submask = {32{sub}};
	assign newb = b ^ submask;
    
    add16 reg1 (a[15:0], newb[15:0], sub, sum[15:0], carry);
    add16 reg2 (a[31:16], newb[31:16], carry, sum[31:16], nada);
    
endmodule
