module top_module (
    input [3:0] x,
    input [3:0] y, 
    output [4:0] sum);

    wire [3:0] carry;
    
    genvar i;
    generate
        for (i=0; i<4; i=i+1) begin:adder_block
            if (i==0) begin
                fadd fa(
                    .a(x[i]),
                    .b(y[i]),
                    .cin(0),
                    .cout(carry[0]),
                    .sum(sum[0])
                );
            end
            else begin
                fadd fa(
                    .a(x[i]),
                    .b(y[i]),
                    .cin(carry[i-1]),
                    .cout(carry[i]),
                    .sum(sum[i])
                );
            end
        end
    endgenerate
    assign sum[4] = carry[3];
endmodule


module fadd( 
    input a, b, cin,
    output cout, sum);

    assign sum = a ^ b ^ cin;
    assign cout = (a & b) | (a & cin) | (b & cin);
    
endmodule
