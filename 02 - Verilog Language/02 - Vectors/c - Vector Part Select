module top_module( 
    input [31:0] in,
    output [31:0] out );//

    genvar i;
    
    // 2. Wrap the loop in a generate block
    generate
        for (i = 0; i < 4; i = i + 1) begin: byte_swap
            
            // 3. Use +: to ensure the compiler knows it's always an 8-bit slice
            assign out[i*8 +: 8] = in[(3-i)*8 +: 8];
            
        end
    endgenerate
        
    
endmodule
