module top_module( 
    input [99:0] a, b,
    input cin,
    output [99:0] cout,
    output [99:0] sum );
    
    genvar i;
    generate
        for (i=0; i<100; i=i+1) begin : adder_block //Essentially makes an array of structs (adder_block[i])
            if (i==0) begin //First block receives initial cin
                full_adder adder_instance( 
                    .a(a[i]),
                    .b(b[i]),
                    .cin(cin),
                    .sum(sum[i]),
                    .cout(cout[i])
                );
            end
            else begin //Every other block receives cout from previous full adder
                full_adder adder_instance(
                    .a(a[i]),
                    .b(b[i]),
                    .cin(cout[i-1]),
                    .sum(sum[i]),
                    .cout(cout[i])
                );
            end
        end
    endgenerate
endmodule

module full_adder( //acting as a function essentially; Module is the blueprint and instance is the accessible ith module
    input a, b, cin,
    output sum, cout);
    
    assign sum = a ^ b ^ cin;
    assign cout = (a&b) | (a & cin) | (b & cin);
    
endmodule
