module top_module (
    input [7:0] in,
    output reg [2:0] pos );
	 always @(*) begin //Need always to start a case/casez
        casez (in) //casez allows for the usage of '?' to ignore bits, so ???1 "doesn't care" about the 3 ? bits
            8'b???????1: pos = 3'd0; //3'd only 3 needed to represent 8 bit number
            8'b??????10: pos = 3'd1;
            8'b?????100: pos = 3'd2;
            8'b????1000: pos = 3'd3;
            8'b???10000: pos = 3'd4;
            8'b??100000: pos = 3'd5;
            8'b?1000000: pos = 3'd6;
            8'b10000000: pos = 3'd7;
            default: pos = 3'd0; //0 is the default
        endcase
    end
endmodule
